# Copy this file to .env and adjust as needed.

# Postgres (used by docker-compose). For local no-docker dev, leave unset to
# use the SQLite fallback (sqlite:///./soc_risk.db).
DATABASE_URL=postgresql://soc_user:soc_password@db:5432/soc_risk

SECRET_KEY=replace-this-with-a-random-secret-in-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional LLM explanation layer. The app works fully with this set to false.
ENABLE_LLM_EXPLANATIONS=false
ANTHROPIC_API_KEY=

FRESH_THRESHOLD_HOURS=24
AGING_THRESHOLD_HOURS=72

CORS_ORIGINS=http://localhost:5173
